# ============================================================
# K2P 闭源 MTK 驱动版（18.06-k5.4）编译配方
# 目标：闭源 mtwifi 驱动 + ZeroTier + 中文界面 + AP 模式
# 写于 2026-10-19
# ============================================================

# ============= 目标板：Phicomm K2P =============
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# ============= ⭐ 核心：闭源 MTK 无线驱动 =============
# mt7615d = MTK 闭源驱动 5.1.0.0（K2P 双频合一芯片）
# luci-app-mtwifi = 闭源驱动的 LuCI 管理界面
CONFIG_PACKAGE_kmod-mt7615d=y
CONFIG_PACKAGE_luci-app-mtwifi=y

# ============= 显式关闭开源 mt76（避免两套驱动冲突）=============
# CONFIG_PACKAGE_kmod-mt76 is not set
# CONFIG_PACKAGE_kmod-mt76-core is not set
# CONFIG_PACKAGE_kmod-mt7603 is not set
# CONFIG_PACKAGE_kmod-mt7615-common is not set
# CONFIG_PACKAGE_kmod-mt7615e is not set
# CONFIG_PACKAGE_kmod-mt7615-firmware is not set
# CONFIG_PACKAGE_kmod-mt76x2 is not set
# CONFIG_PACKAGE_kmod-mt76x2-common is not set
# CONFIG_PACKAGE_kmod-mt76x02-common is not set
# CONFIG_PACKAGE_kmod-mt76-connac is not set

# ============= ZeroTier（与开源版一致）=============
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# ============= 基础网络 =============
CONFIG_PACKAGE_dnsmasq-full=y

# ============= 内存优化（128MB RAM 必备）=============
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# ============= 必备工具（与开源版一致）=============
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-wol=y

# ============= LuCI 与中文界面 =============
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ============= 关闭无关大件（省 flash）=============
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-wireguard is not set
# CONFIG_PACKAGE_luci-app-samba is not set
# CONFIG_PACKAGE_luci-app-transmission is not set
# CONFIG_PACKAGE_luci-app-adbyby-fix is not set
# CONFIG_PACKAGE_luci-app-mwan3helper-chinaroute is not set
# CONFIG_PACKAGE_luci-app-eqos-mtk is not set
# CONFIG_PACKAGE_luci-app-autosamba is not set
# CONFIG_PACKAGE_luci-app-automount is not set
# CONFIG_PACKAGE_luci-app-autocore is not set
